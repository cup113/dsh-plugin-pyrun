{
  "name": "dsh-plugin-pyrun",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cup113/dsh-plugin-pyrun.git"
  },
  "bugs": {
    "url": "https://github.com/cup113/dsh-plugin-pyrun/issues"
  },
  "type": "module",
